# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git!

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key-use-secrets-token-hex-32
FLASK_ENV=production
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Database Configuration (SQLite by default)
DATABASE_PATH=data/tenants.db

# Email Configuration (Gmail example)
# Leave empty to run in test mode (emails not sent)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-gmail-app-password

# Application Settings
APP_NAME=Tenant Management System
PG_NAME=Your PG Name Here
TIMEZONE=Asia/Kolkata

# Backup Configuration
BACKUP_ENABLED=True
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# QR Code Configuration
QR_CODE_DIR=static/qrcodes
BASE_URL=http://localhost:5000

# Security Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_QR_GENERATION=True
ENABLE_PAYMENT_TRACKING=True

# Limits
MAX_TENANTS=1000
MAX_UPLOAD_SIZE_MB=10

# Optional: Basic Authentication
# Leave empty to disable
AUTH_USERNAME=
AUTH_PASSWORD=
